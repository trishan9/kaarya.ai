    "test:watch": "jest --config ./test/jest.unit.json --watch",
    "test:cov": "jest --config ./test/jest.all.json --coverage --coverageDirectory ./coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config ./test/jest.unit.json",
